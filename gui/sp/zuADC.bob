  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_4</name>
    <x>720</x>
    <y>114</y>
    <width>460</width>
    <show_legend>false</show_legend>
    <rules>
      <rule name="Point Shape" prop_id="traces[0].point_type" out_exp="false">
        <exp bool_exp="pv0&lt;=1000">
          <value>2</value>
        </exp>
        <pv_name>$(P){BPM:$(NO)}ADC:WfmLen-SP</pv_name>
      </rule>
      <rule name="Point Size" prop_id="traces[0].point_size" out_exp="false">
        <exp bool_exp="pv0&gt;500 and pv0&lt;=1000">
          <value>3</value>
        </exp>
        <exp bool_exp="pv0&gt;250 and pv0&lt;=500">
          <value>5</value>
        </exp>
        <exp bool_exp="pvo&gt;100 and pv0&lt;=250">
          <value>7</value>
        </exp>
        <exp bool_exp="pv0&lt;=100">
          <value>9</value>
        </exp>
        <pv_name>$(P){BPM:$(NO)}ADC:WfmLen-SP</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>ADC Sample Number</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>ADC:B (Counts)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name></name>
        <x_pv></x_pv>
        <y_pv>$(P){BPM:$(NO)}ADC:B-Wfm</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
